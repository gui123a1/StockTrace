# Copy to /etc/stocktrace/env and fill in values. Do not commit real secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=stocktrace.yumeat.cc.cd,127.0.0.1
# Optional overrides
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=2
# STOCKTRACE_SCHEDULER=1
# STOCKTRACE_UPSTREAM_TIMEOUT=30
